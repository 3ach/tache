# Todoist personal API token: Settings -> Integrations -> Developer
TODOIST_API_TOKEN=

# Client secret of the Todoist app (developer.todoist.com) whose webhook
# points at this server; used to verify X-Todoist-Hmac-SHA256 signatures.
TODOIST_CLIENT_SECRET=

# Address the webhook server binds to (fronted by nginx on zach.network)
TACHE_BIND=127.0.0.1:8321
