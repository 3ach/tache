# Todoist app credentials (developer.todoist.com). The client secret also
# verifies webhook X-Todoist-Hmac-SHA256 signatures. With both set, visit
# /oauth/start once: the server exchanges the code at /oauth/callback,
# persists the token to TACHE_TOKEN_FILE, and webhooks activate.
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Optional: personal API token. The OAuth flow supersedes this; only used
# if no persisted token exists. Required for CLI commands run locally.
TODOIST_API_TOKEN=

# Where the OAuth-minted token is persisted (docker image sets /data/token)
#TACHE_TOKEN_FILE=tache-token

# Address the webhook server binds to (fronted by Caddy on zach.network)
TACHE_BIND=127.0.0.1:8321

# Minutes between periodic reconciles (safety net for dropped webhook
# deliveries). 0 disables the timer.
#TACHE_SYNC_MINUTES=15
